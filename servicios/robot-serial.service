[Unit]
Description=DINAVEX - Comunicacion USB STM32
After=systemd-udevd.service

[Service]
Type=simple
User=robot
SupplementaryGroups=dialout

WorkingDirectory=/home/robot/DINAVEX/serial

ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && exec /usr/bin/python3 /home/robot/DINAVEX/serial/receptor_stm32.py'

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
